{
  "name": "@scope/studio-extension",
  "version": "0.1.4",
  "private": true,
  "license": "MIT",
  "description": "\u89c1\u5fae SCOPE vision workspace for Eclipse Theia",
  "keywords": [
    "theia-extension"
  ],
  "files": [
    "lib",
    "style",
    "resources"
  ],
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/output": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0",
    "color-convert": "2.0.1",
    "iconv-lite": "0.6.3"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "test:tutor": "npm run compile && node --test test/tutor-plan.cjs test/tutor-course.cjs test/tutor-course-repository.cjs test/tutor-storage.cjs test/tutor-chat-session.cjs test/tutor-model-gateway.cjs test/tutor-ai-settings.cjs test/tutor-editor-guidance.cjs",
    "test:launcher": "npm run compile && node --test test/launcher.cjs"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/scope-frontend-module",
      "frontendPreload": "lib/browser/nodu-i18n-preload",
      "backend": "lib/node/nodu-backend-module"
    },
    {
      "frontendElectron": "lib/electron-browser/nodu-launcher-module",
      "electronMain": "lib/electron-main/nodu-electron-main-module"
    }
  ]
}
