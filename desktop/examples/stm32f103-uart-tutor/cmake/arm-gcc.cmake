# Arm GNU 工具链文件。查找顺序：-DARM_TOOLCHAIN_ROOT → 环境变量
# NODU_STM32_TOOLKIT（Nodu 编译时设置）→ PATH 中的 arm-none-eabi-gcc。
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARM_TOOLCHAIN_ROOT)
if(NOT DEFINED ARM_TOOLCHAIN_ROOT)
  if(DEFINED ENV{NODU_STM32_TOOLKIT})
    set(ARM_TOOLCHAIN_ROOT "$ENV{NODU_STM32_TOOLKIT}/arm-gnu")
  else()
    find_program(NODU_ARM_GCC arm-none-eabi-gcc REQUIRED)
    get_filename_component(ARM_TOOLCHAIN_ROOT "${NODU_ARM_GCC}" DIRECTORY)
    get_filename_component(ARM_TOOLCHAIN_ROOT "${ARM_TOOLCHAIN_ROOT}" DIRECTORY)
  endif()
endif()
if(CMAKE_HOST_WIN32)
  set(NODU_EXE .exe)
else()
  set(NODU_EXE "")
endif()
set(CMAKE_C_COMPILER "${ARM_TOOLCHAIN_ROOT}/bin/arm-none-eabi-gcc${NODU_EXE}")
set(CMAKE_ASM_COMPILER "${ARM_TOOLCHAIN_ROOT}/bin/arm-none-eabi-gcc${NODU_EXE}")
set(CMAKE_OBJCOPY "${ARM_TOOLCHAIN_ROOT}/bin/arm-none-eabi-objcopy${NODU_EXE}")
set(CMAKE_SIZE "${ARM_TOOLCHAIN_ROOT}/bin/arm-none-eabi-size${NODU_EXE}")
set(CMAKE_C_FLAGS_INIT "-mthumb")
set(CMAKE_ASM_FLAGS_INIT "-mthumb")
