{
  "name": "scope-studio",
  "private": true,
  "version": "0.2.2",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "scope-extension",
    "browser-app",
    "electron-app"
  ],
  "scripts": {
    "compile": "npm run build:plugins && npm run build:imaging && npm run compile --workspace @scope/studio-extension",
    "build:browser": "npm run build:native && npm run build:arduino-tools && npm run compile && npm run build --workspace @scope/browser-app",
    "build:electron": "npm run build:native && npm run build:media && npm run build:arduino-tools && npm run compile && npm run build --workspace @scope/electron-app",
    "start:browser": "npm run start --workspace @scope/browser-app",
    "start:electron": "npm run start --workspace @scope/electron-app",
    "rebuild:browser": "npm run rebuild --workspace @scope/browser-app",
    "rebuild:electron": "npm run rebuild --workspace @scope/electron-app",
    "postinstall": "theia-patch",
    "setup:device": "node scripts/setup-device.cjs",
    "build:native": "node scripts/build-native.cjs",
    "build:imaging": "node scripts/build-imaging.cjs",
    "build:media": "node scripts/build-media.cjs",
    "fetch:models": "node scripts/fetch-models.cjs",
    "vendor:examples": "node scripts/vendor-examples.cjs",
    "build:models": "node scripts/build-models.cjs",
    "check:licenses": "node scripts/check-licenses.cjs",
    "check:brand": "node scripts/check-brand.cjs",
    "package:electron": "node scripts/package-electron.cjs",
    "build:plugins": "node scripts/build-clangd-plugin.cjs && node scripts/build-arduino-language-plugin.cjs",
    "build:arduino-tools": "node scripts/build-arduino-language-tools.cjs",
    "prepare:arduino-release": "node scripts/prepare-arduino-release.cjs",
    "test:arduino-package": "node --test scripts/package-arduino.test.cjs",
    "test:arduino-language": "node --test scope-extension/test/arduino-language.cjs scripts/arduino-language-adapter.test.cjs scripts/arduino-language-grammar.test.cjs",
    "test:arduino-language:e2e": "node scripts/arduino-language.e2e.cjs",
    "templates:daxin:check": "node scripts/sync-daxin-templates.cjs --check",
    "templates:daxin:sync": "node scripts/sync-daxin-templates.cjs --write",
    "prepare:tutor-tools": "python3 scripts/prepare-tutor-tools.py",
    "test:tutor-tools": "python3 scripts/test-prepare-tutor-tools.py && node --test scripts/package-tutor-tools.test.cjs",
    "test:arduino-language:package": "node --test scripts/package-arduino-language.test.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/universal": "3.0.6",
    "@theia/cli": "1.76.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "allowScripts": {
    "@theia/ffmpeg": true,
    "esbuild": true,
    "@parcel/watcher": true,
    "drivelist": true,
    "keytar": true,
    "native-keymap": true,
    "node-pty": true,
    "msgpackr-extract": true,
    "electron": true,
    "puppeteer": false
  }
}
