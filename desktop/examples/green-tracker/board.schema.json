{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nodu MaixPy 示例项目描述",
  "type": "object",
  "required": ["project", "runtime", "chip", "entry"],
  "properties": {
    "$schema": { "type": "string" },
    "project": { "type": "string" },
    "displayName": { "type": "string" },
    "runtime": { "const": "MaixPy-v1" },
    "chip": { "const": "K210" },
    "firmwareSourceCommit": { "type": "string" },
    "camera": {
      "type": "object",
      "properties": {
        "sensor": { "type": "string" },
        "initialization": { "enum": ["board-helper", "generic"] },
        "pixelFormat": { "const": "RGB565" },
        "frameSize": { "const": "QVGA" },
        "width": { "const": 320 },
        "height": { "const": 240 }
      }
    },
    "entry": { "type": "string" },
    "files": { "type": "array", "items": { "type": "string" } },
    "boardProfile": { "type": ["string", "null"] },
    "serialPort": { "type": ["string", "null"] },
    "requiresDeviceFiles": { "type": "array", "items": { "type": "string" } },
    "note": { "type": "string" }
  }
}
