{
  "schema": 1,
  "kind": "stm32-hal",
  "name": "f103-tutor",
  "target": {
    "mcu": "STM32F103C8Tx",
    "board": "chip-f103c8@1"
  },
  "sdk": "stm32cube-f1@1.8.7",
  "build": {
    "preset": "debug",
    "printfFloat": false
  },
  "flash": {
    "method": "stlink"
  },
  "monitor": {
    "baud": 115200,
    "encoding": "utf-8",
    "lineEnding": "lf"
  }
}
